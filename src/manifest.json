{
  "manifest_version": 3,
  "name": "ARD Mediathek Subtitle Extractor",
  "version": "1.0",
  "description": "Detects, extracts, and displays video subtitles from ARD Mediathek.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ardmediathek.de/*"],
      "js": ["content.js"]
    }
  ]
}