{
  "manifest_version": 3,
  "name": "Netflix Subtitle Translator",
  "version": "1.0",
  "permissions": ["scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["*://*.google.com/*", "*://*.netflix.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["*://*.netflix.com/*"],
    "css": ["styles.css"],
    "js": ["content.js"]
  }],
  "background": {
    "service_worker": "background.js"
  }
}