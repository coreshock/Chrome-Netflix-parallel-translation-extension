{
    "manifest_version": 3,
    "name": "Netflix Parallel Translation",
    "version": "1.3.3",
    "description": "Adds parallel translation to Netflix subtitles",
    "permissions": [
        "storage",
        "scripting",
        "tabs",
        "activeTab"
    ],
    "host_permissions": [
        "https://www.netflix.com/*",
        "https://www.youtube.com/*",
        "https://translate.googleapis.com/*"
    ],
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.netflix.com/*",
                "https://www.youtube.com/*"
            ],
            "js": [
                "content-loader.js"
            ],
            "css": [],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "content.js",
                "popup.css",
                "icon.png",
                "assets/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}